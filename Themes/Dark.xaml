<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ DARK THEME — near-black surfaces + brand red (#E5202E) ══════════
         Every key here MUST also exist in Light.xaml.
         Colors (Color*) are for effects/gradients; Brushes are for everything else. -->

    <!-- Surfaces (darkest → lightest) -->
    <Color x:Key="ColorBgApp">#07090B</Color>
    <Color x:Key="ColorBgSidebar">#0E1115</Color>
    <Color x:Key="ColorBgPanel">#0E1115</Color>
    <Color x:Key="ColorBgCard">#151A20</Color>
    <Color x:Key="ColorBgInput">#12161C</Color>
    <Color x:Key="ColorBgHover">#1B2128</Color>
    <Color x:Key="ColorBgSelected">#242B34</Color>

    <!-- Lines -->
    <Color x:Key="ColorBorder">#20262E</Color>
    <Color x:Key="ColorBorderStrong">#303844</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#F2F3F5</Color>
    <Color x:Key="ColorTextSecondary">#A3AAB5</Color>
    <Color x:Key="ColorTextMuted">#6C7480</Color>
    <Color x:Key="ColorTextDisabled">#474E59</Color>

    <!-- Brand accent -->
    <Color x:Key="ColorAccent">#E5202E</Color>
    <Color x:Key="ColorAccentHover">#F2303E</Color>
    <Color x:Key="ColorAccentPressed">#C21723</Color>
    <Color x:Key="ColorAccentSoft">#26E5202E</Color>
    <Color x:Key="ColorAccentBorder">#66E5202E</Color>
    <Color x:Key="ColorOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorAccentText">#FF5B67</Color>

    <!-- Status -->
    <Color x:Key="ColorSuccess">#34C77B</Color>
    <Color x:Key="ColorSuccessSoft">#2234C77B</Color>
    <Color x:Key="ColorWarning">#F5A623</Color>
    <Color x:Key="ColorWarningSoft">#22F5A623</Color>
    <Color x:Key="ColorDanger">#FF5C6A</Color>
    <Color x:Key="ColorDangerSoft">#22FF5C6A</Color>
    <Color x:Key="ColorInfo">#5B9DFF</Color>
    <Color x:Key="ColorInfoSoft">#225B9DFF</Color>

    <!-- Misc -->
    <Color x:Key="ColorHoverWash">#12FFFFFF</Color>
    <Color x:Key="ColorShadow">#000000</Color>
    <Color x:Key="ColorVideoBg">#000000</Color>

    <SolidColorBrush x:Key="BgApp"          Color="#07090B"/>
    <SolidColorBrush x:Key="BgSidebar"      Color="#0E1115"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#0E1115"/>
    <SolidColorBrush x:Key="BgCard"         Color="#151A20"/>
    <SolidColorBrush x:Key="BgInput"        Color="#12161C"/>
    <SolidColorBrush x:Key="BgHover"        Color="#1B2128"/>
    <SolidColorBrush x:Key="BgSelected"     Color="#242B34"/>
    <SolidColorBrush x:Key="Border"         Color="#20262E"/>
    <SolidColorBrush x:Key="BorderStrong"   Color="#303844"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#F2F3F5"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#A3AAB5"/>
    <SolidColorBrush x:Key="TextMuted"      Color="#6C7480"/>
    <SolidColorBrush x:Key="TextDisabled"   Color="#474E59"/>
    <SolidColorBrush x:Key="Accent"         Color="#E5202E"/>
    <SolidColorBrush x:Key="AccentHover"    Color="#F2303E"/>
    <SolidColorBrush x:Key="AccentPressed"  Color="#C21723"/>
    <SolidColorBrush x:Key="AccentSoft"     Color="#26E5202E"/>
    <SolidColorBrush x:Key="AccentBorder"   Color="#66E5202E"/>
    <SolidColorBrush x:Key="OnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentText"     Color="#FF5B67"/>
    <SolidColorBrush x:Key="Success"        Color="#34C77B"/>
    <SolidColorBrush x:Key="SuccessSoft"    Color="#2234C77B"/>
    <SolidColorBrush x:Key="Warning"        Color="#F5A623"/>
    <SolidColorBrush x:Key="WarningSoft"    Color="#22F5A623"/>
    <SolidColorBrush x:Key="Danger"         Color="#FF5C6A"/>
    <SolidColorBrush x:Key="DangerSoft"     Color="#22FF5C6A"/>
    <SolidColorBrush x:Key="Info"           Color="#5B9DFF"/>
    <SolidColorBrush x:Key="InfoSoft"       Color="#225B9DFF"/>
    <SolidColorBrush x:Key="HoverWash"      Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="VideoBg"        Color="#000000"/>

</ResourceDictionary>
