<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ LIGHT THEME — clean off-white surfaces + brand red ══════════════
         Must define exactly the same keys as Dark.xaml. -->

    <Color x:Key="ColorBgApp">#E8EBEF</Color>
    <Color x:Key="ColorBgSidebar">#FFFFFF</Color>
    <Color x:Key="ColorBgPanel">#FFFFFF</Color>
    <Color x:Key="ColorBgCard">#F4F6F8</Color>
    <Color x:Key="ColorBgInput">#EEF0F3</Color>
    <Color x:Key="ColorBgHover">#E9ECF0</Color>
    <Color x:Key="ColorBgSelected">#DFE3E8</Color>

    <Color x:Key="ColorBorder">#E1E4E9</Color>
    <Color x:Key="ColorBorderStrong">#C9CED6</Color>

    <Color x:Key="ColorTextPrimary">#0F1318</Color>
    <Color x:Key="ColorTextSecondary">#4B5563</Color>
    <Color x:Key="ColorTextMuted">#8A93A0</Color>
    <Color x:Key="ColorTextDisabled">#B6BDC8</Color>

    <Color x:Key="ColorAccent">#D81B2A</Color>
    <Color x:Key="ColorAccentHover">#E5303E</Color>
    <Color x:Key="ColorAccentPressed">#B71421</Color>
    <Color x:Key="ColorAccentSoft">#1AD81B2A</Color>
    <Color x:Key="ColorAccentBorder">#55D81B2A</Color>
    <Color x:Key="ColorOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorAccentText">#C0121F</Color>

    <Color x:Key="ColorSuccess">#1B9E5B</Color>
    <Color x:Key="ColorSuccessSoft">#1A1B9E5B</Color>
    <Color x:Key="ColorWarning">#C97F00</Color>
    <Color x:Key="ColorWarningSoft">#1AC97F00</Color>
    <Color x:Key="ColorDanger">#D4283A</Color>
    <Color x:Key="ColorDangerSoft">#1AD4283A</Color>
    <Color x:Key="ColorInfo">#2563EB</Color>
    <Color x:Key="ColorInfoSoft">#1A2563EB</Color>

    <Color x:Key="ColorHoverWash">#0D000000</Color>
    <Color x:Key="ColorShadow">#1F2937</Color>
    <Color x:Key="ColorVideoBg">#000000</Color>

    <SolidColorBrush x:Key="BgApp"          Color="#E8EBEF"/>
    <SolidColorBrush x:Key="BgSidebar"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCard"         Color="#F4F6F8"/>
    <SolidColorBrush x:Key="BgInput"        Color="#EEF0F3"/>
    <SolidColorBrush x:Key="BgHover"        Color="#E9ECF0"/>
    <SolidColorBrush x:Key="BgSelected"     Color="#DFE3E8"/>
    <SolidColorBrush x:Key="Border"         Color="#E1E4E9"/>
    <SolidColorBrush x:Key="BorderStrong"   Color="#C9CED6"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#0F1318"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#4B5563"/>
    <SolidColorBrush x:Key="TextMuted"      Color="#8A93A0"/>
    <SolidColorBrush x:Key="TextDisabled"   Color="#B6BDC8"/>
    <SolidColorBrush x:Key="Accent"         Color="#D81B2A"/>
    <SolidColorBrush x:Key="AccentHover"    Color="#E5303E"/>
    <SolidColorBrush x:Key="AccentPressed"  Color="#B71421"/>
    <SolidColorBrush x:Key="AccentSoft"     Color="#1AD81B2A"/>
    <SolidColorBrush x:Key="AccentBorder"   Color="#55D81B2A"/>
    <SolidColorBrush x:Key="OnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentText"     Color="#C0121F"/>
    <SolidColorBrush x:Key="Success"        Color="#1B9E5B"/>
    <SolidColorBrush x:Key="SuccessSoft"    Color="#1A1B9E5B"/>
    <SolidColorBrush x:Key="Warning"        Color="#C97F00"/>
    <SolidColorBrush x:Key="WarningSoft"    Color="#1AC97F00"/>
    <SolidColorBrush x:Key="Danger"         Color="#D4283A"/>
    <SolidColorBrush x:Key="DangerSoft"     Color="#1AD4283A"/>
    <SolidColorBrush x:Key="Info"           Color="#2563EB"/>
    <SolidColorBrush x:Key="InfoSoft"       Color="#1A2563EB"/>
    <SolidColorBrush x:Key="HoverWash"      Color="#0D000000"/>
    <SolidColorBrush x:Key="VideoBg"        Color="#000000"/>

</ResourceDictionary>
