<UserControl x:Class="AiAssistant.MediaLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiAssistant"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: library grid ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="24,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Library}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="მედია ბიბლიოთეკა" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="დამუშავებული, ჩამოტვირთული და ლაივ კლიპები — ერთ ადგილას, პრევიუთი"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStats" Text="0 ფაილი" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                </Grid>

                <!-- toolbar -->
                <Grid Grid.Row="1" Margin="0,18,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="44" CornerRadius="12" Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                     Padding="0" FontSize="13.5" VerticalContentAlignment="Center"
                                     local:Ui.Hint="ძებნა სახელით…" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Grid.Column="2" x:Name="TxtCount" FontSize="11.5" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FAll" GroupName="LibFilter" Tag="all" IsChecked="True"
                                         Style="{StaticResource SpeedSegment}" Content="ყველა" Padding="13,8" Margin="0"
                                         Click="Filter_Changed"/>
                            <RadioButton GroupName="LibFilter" Tag="processed" Style="{StaticResource SpeedSegment}"
                                         Content="დამუშავებული" Padding="13,8" Margin="0" Click="Filter_Changed"/>
                            <RadioButton GroupName="LibFilter" Tag="download" Style="{StaticResource SpeedSegment}"
                                         Content="ჩამოტვირთული" Padding="13,8" Margin="0" Click="Filter_Changed"/>
                            <RadioButton GroupName="LibFilter" Tag="live" Style="{StaticResource SpeedSegment}"
                                         Content="ლაივ კლიპები" Padding="13,8" Margin="0" Click="Filter_Changed"/>
                        </StackPanel>
                    </Border>

                    <ComboBox Grid.Column="4" x:Name="CmbSort" Width="160" Height="44" SelectedIndex="0"
                              VerticalContentAlignment="Center" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="ახალი ჯერ" Tag="new"/>
                        <ComboBoxItem Content="ძველი ჯერ" Tag="old"/>
                        <ComboBoxItem Content="სახელით" Tag="name"/>
                        <ComboBoxItem Content="ზომით (დიდი ჯერ)" Tag="size"/>
                        <ComboBoxItem Content="ხანგრძლივობით" Tag="dur"/>
                    </ComboBox>

                    <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Height="44" Padding="14,0"
                            ToolTip="საქაღალდის დამატება ბიბლიოთეკაში" Click="BtnAddFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="საქაღალდე" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="8" Style="{StaticResource ToolButton}" Content="&#xE72C;" Height="44" Width="44"
                            ToolTip="განახლება" Click="BtnRefresh_Click"/>
                </Grid>

                <!-- grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,70,0,0" Visibility="Collapsed">
                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                <Ellipse Fill="{DynamicResource AccentSoft}"/>
                                <Ellipse Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" Margin="9"/>
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TxtEmptyTitle" Text="ბიბლიოთეკა ცარიელია" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,18,0,0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEmptySub" FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="დაამუშავე, ჩამოტვირთე ან ჩაწერე ვიდეო — აქ გამოჩნდება. შეგიძლია ნებისმიერი საქაღალდეც დაამატო."/>
                        </StackPanel>
                        <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════ RIGHT: details / preview ═══════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20">
            <Grid>
                <StackPanel x:Name="DetailsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                               Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    <TextBlock Text="აირჩიე ვიდეო პრევიუსთვის" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="ორჯერ დაჭერა გახსნის მონტაჟში" FontSize="12"
                               Foreground="{DynamicResource TextDisabled}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer x:Name="DetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <!-- preview -->
                        <Border CornerRadius="14" Background="{DynamicResource VideoBg}" Height="225" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="DImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <MediaElement x:Name="DMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" Visibility="Collapsed" ScrubbingEnabled="True"
                                              MediaOpened="DMedia_Opened" MediaEnded="DMedia_Ended"/>
                                <Button x:Name="BtnDPlay" Style="{StaticResource PrimaryButton}" Width="56" Height="56"
                                        Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                        Click="BtnDPlay_Click"/>
                            </Grid>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtDCur" Text="0:00" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" x:Name="SlDSeek" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                                    ValueChanged="SlDSeek_Changed" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TxtDTot" Text="0:00" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="TxtDTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" Margin="2,16,0,0"/>
                        <WrapPanel x:Name="DChips" Margin="0,10,0,0"/>

                        <!-- actions -->
                        <TextBlock Text="გამოყენება" Style="{StaticResource SectionLabel}" Margin="2,12,0,10"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,6,8" Padding="0,11" Click="BtnEditor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="მინი მონტაჟი" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,8" Padding="0,11" Click="BtnCrop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="ვერტიკალი" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,8" Padding="0,11" Click="BtnFaceBlur_Click"
                                    ToolTip="სახეების დაბუნდოვნება">
                                <TextBlock Text="სახის დაბუნდოვნება"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,8" Padding="0,11" Click="BtnVoiceOver_Click"
                                    ToolTip="ხმის ჩაწერა ვიდეოზე">
                                <TextBlock Text="ხმის ჩაწერა"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,8" Padding="0,11" Click="BtnAbA_Click"
                                    ToolTip="გაიხსნება A/B მონიტორში როგორც A (ორიგინალი)">
                                <TextBlock Text="A/B — როგორც A"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,8" Padding="0,11" Click="BtnAbB_Click"
                                    ToolTip="გაიხსნება A/B მონიტორში როგორც B (დამუშავებული)">
                                <TextBlock Text="A/B — როგორც B"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="0,11" Click="BtnPlayExternal_Click">
                                <TextBlock Text="სისტემურ პლეერში"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="0,11" Click="BtnReveal_Click">
                                <TextBlock Text="საქაღალდეში"/>
                            </Button>
                        </UniformGrid>

                        <Button Style="{StaticResource DangerButton}" Margin="0,16,0,6" Padding="0,11" Click="BtnDelete_Click"
                                ToolTip="ფაილი გადავა Recycle Bin-ში">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="წაშლა (Recycle Bin)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TxtDPath" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" Margin="2,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
