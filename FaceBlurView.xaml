<UserControl x:Class="AiAssistant.FaceBlurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiAssistant"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: preview + actions ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="24,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Face}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="სახის დაბუნდოვნება" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="ავტომატურად პოულობს სახეებს და მთელ ვიდეოზე მიჰყვება — აირჩიე ვის დაუმალო სახე"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="StepChip" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStep" Text="1 · აირჩიე ვიდეო" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                </Grid>

                <!-- preview -->
                <Border Grid.Row="1" x:Name="PreviewBox" Margin="0,18,0,0" CornerRadius="16" ClipToBounds="True"
                        Background="{DynamicResource VideoBg}" AllowDrop="True" MinHeight="200"
                        DragEnter="Drag_Enter" DragOver="Drag_Enter" DragLeave="Drag_Leave" Drop="Drag_Drop">
                    <Grid>
                        <Image x:Name="PvImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               SizeChanged="Preview_SizeChanged"/>
                        <!-- coloured frames / numbers of the people (drawn from the analysis) -->
                        <Canvas x:Name="PvOverlay" IsHitTestVisible="False" ClipToBounds="True"/>

                        <!-- empty state -->
                        <StackPanel x:Name="DropZone" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                <Ellipse Fill="{DynamicResource AccentSoft}"/>
                                <Ellipse Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" Margin="9"/>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="გადმოათრიე ვიდეო აქ" FontSize="17" FontWeight="SemiBold" Foreground="#E6E8EC"
                                       Margin="0,18,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="ან აირჩიე ფაილი — მერე პროგრამა სახეებს თვითონ იპოვის"
                                       FontSize="12.5" Foreground="#8A919C" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="ვიდეოს არჩევა" Padding="22,11"
                                    Margin="0,20,0,0" HorizontalAlignment="Center" Click="BtnPick_Click"/>
                        </StackPanel>

                        <!-- original / result switch -->
                        <Border x:Name="ViewSwitch" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0"
                                Background="#CC0B0D10" CornerRadius="11" Padding="3" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbOriginal" GroupName="FbView" Style="{StaticResource SpeedSegment}"
                                             Content="ორიგინალი" Padding="12,6" FontSize="12" Margin="0" Click="View_Changed"/>
                                <RadioButton x:Name="RbResult" GroupName="FbView" IsChecked="True" Style="{StaticResource SpeedSegment}"
                                             Content="შედეგი" Padding="12,6" FontSize="12" Margin="0" Click="View_Changed"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnChange" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                Style="{StaticResource SecondaryButton}" Content="ვიდეოს შეცვლა" Padding="12,7" FontSize="12"
                                Visibility="Collapsed" Click="BtnPick_Click"/>

                        <!-- busy -->
                        <Border x:Name="Busy" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,18" Background="#E60E1115" CornerRadius="18" Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource Accent}" Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBusy" Text="ვამუშავებ…" FontSize="12.5" Foreground="#E6E8EC"/>
                            </StackPanel>
                        </Border>

                        <!-- drag highlight -->
                        <Border x:Name="DragOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                                BorderThickness="2" CornerRadius="16"/>
                    </Grid>
                </Border>

                <!-- scrubber -->
                <Grid Grid.Row="2" Margin="0,12,0,0" x:Name="ScrubRow" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTime" Text="0:00" FontFamily="Consolas" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <Slider Grid.Column="1" x:Name="SlFrame" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            ValueChanged="SlFrame_Changed" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TxtTotal" Text="0:00" FontFamily="Consolas" FontSize="12.5"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <!-- who is on screen when: one lane per person, same colour / number as the card on the right -->
                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" x:Name="LaneScroll" Margin="0,8,0,0" MaxHeight="116"
                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="LaneBadges" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <Canvas Grid.Column="1" x:Name="LaneCanvas" Background="Transparent" Cursor="Hand" SnapsToDevicePixels="True"
                                    SizeChanged="Lanes_SizeChanged" MouseLeftButtonDown="Lanes_MouseDown"
                                    MouseMove="Lanes_MouseMove" MouseLeftButtonUp="Lanes_MouseUp" MouseRightButtonUp="Lanes_RightUp"
                                    ToolTip="დააჭირე — გადახვალ ამ მომენტზე · გადაწიე ზოლის კიდე — გაგრძელდება ან შემოკლდება დაბუნდოვნება · მარჯვენა კლავიში — ხელით ცვლილებების გაუქმება"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                <!-- action bar -->
                <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="14" Padding="16,12"
                        Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFile" Text="ვიდეო არ არის არჩეული" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtStatus" Text="" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="Pb" Height="5" Margin="0,9,0,0" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left" Width="520"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCompare" Style="{StaticResource SecondaryButton}" Content="A/B შედარება"
                                    Padding="14,11" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCompare_Click"/>
                            <Button x:Name="BtnReveal" Style="{StaticResource SecondaryButton}" Content="საქაღალდეში"
                                    Padding="14,11" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnReveal_Click"/>
                            <Button x:Name="BtnAnalyze" Style="{StaticResource GlowPrimaryButton}" Padding="22,12"
                                    IsEnabled="False" Click="BtnAnalyze_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="სახეების ძებნა" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRender" Style="{StaticResource GlowPrimaryButton}" Padding="22,12"
                                    Visibility="Collapsed" Click="BtnRender_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="დაბუნდოვნება" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCancel" Style="{StaticResource DangerButton}" Content="გაჩერება"
                                    Padding="18,11" Visibility="Collapsed" Click="BtnCancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ RIGHT: people + style ═══════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20,20,14,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <!-- search accuracy -->
                    <TextBlock Text="ძიების სიზუსტე" Style="{StaticResource SectionLabel}" Margin="2,0,0,10"/>
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <RadioButton x:Name="QFast" GroupName="FbQuality" Tag="fast" Style="{StaticResource ModeCard}"
                                     Margin="0,0,6,0" Click="Quality_Changed"
                                     ToolTip="ყველაზე სწრაფი — დიდი და ნათელი სახეებისთვის">
                            <TextBlock Text="სწრაფი" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton x:Name="QBal" GroupName="FbQuality" Tag="balanced" IsChecked="True" Style="{StaticResource ModeCard}"
                                     Margin="3,0,3,0" Click="Quality_Changed"
                                     ToolTip="რეკომენდებული — სიჩქარისა და სიზუსტის ბალანსი">
                            <TextBlock Text="ბალანსი" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton x:Name="QMax" GroupName="FbQuality" Tag="max" Style="{StaticResource ModeCard}"
                                     Margin="6,0,0,0" Click="Quality_Changed"
                                     ToolTip="მაქსიმალური — პატარა და შორეული სახეებიც, მაგრამ ნელა (3-4× დრო)">
                            <TextBlock Text="მაქსიმუმი" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock x:Name="TxtQualityHint" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="ბრბოს ან შორეული სახეებისთვის აირჩიე „მაქსიმუმი“." Margin="2,0,0,18"/>

                    <!-- people -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ადამიანები" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnAll" Style="{StaticResource GhostButton}" Content="ყველა" Padding="10,5"
                                FontSize="12" Visibility="Collapsed" Click="BtnAll_Click"/>
                        <Button Grid.Column="2" x:Name="BtnNone" Style="{StaticResource GhostButton}" Content="არცერთი" Padding="10,5"
                                FontSize="12" Margin="4,0,0,0" Visibility="Collapsed" Click="BtnNone_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtPeopleHint" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="ჯერ დააჭირე „სახეების ძებნა“ — აქ გამოჩნდება ვიდეოში ნანახი თითოეული ადამიანი. რომელსაც ჩართული აქვს ჩამრთველი, მას სახე დაუბუნდოვნდება."
                               Margin="0,0,0,16"/>
                    <StackPanel x:Name="PeoplePanel" Margin="0,0,0,8"/>

                    <!-- style -->
                    <TextBlock Text="სტილი" Style="{StaticResource SectionLabel}" Margin="2,10,0,10"/>
                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <RadioButton x:Name="StBlur" GroupName="FbStyle" Tag="blur" IsChecked="True"
                                     Style="{StaticResource ModeCard}" Margin="0,0,6,0" Click="Style_Changed">
                            <StackPanel>
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <TextBlock Text="დაბუნდ." FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StPixel" GroupName="FbStyle" Tag="pixel" Style="{StaticResource ModeCard}"
                                     Margin="3,0,3,0" Click="Style_Changed">
                            <StackPanel>
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <TextBlock Text="პიქსელები" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StBlack" GroupName="FbStyle" Tag="black" Style="{StaticResource ModeCard}"
                                     Margin="6,0,0,0" Click="Style_Changed">
                            <StackPanel>
                                <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                                <TextBlock Text="შავი" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border Style="{StaticResource TileCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="სიძლიერე" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SlStrength" Minimum="10" Maximum="100" Value="70"
                                        ValueChanged="Param_Changed" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TxtStrength" Text="70%" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="დაფარვა" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           ToolTip="რამდენად გასცდეს სახეს (თმა, ყურები)"/>
                                <Slider Grid.Column="1" x:Name="SlPad" Minimum="0" Maximum="80" Value="30"
                                        ValueChanged="Param_Changed" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TxtPad" Text="30%" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ფორმა" Style="{StaticResource SectionLabel}" Margin="2,14,0,10"/>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ShEllipse" GroupName="FbShape" IsChecked="True" Style="{StaticResource SpeedSegment}"
                                         Content="ოვალი" Padding="18,8" Margin="0" Click="Style_Changed"/>
                            <RadioButton x:Name="ShRect" GroupName="FbShape" Style="{StaticResource SpeedSegment}"
                                         Content="მართკუთხედი" Padding="14,8" Margin="0" Click="Style_Changed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="2,22,0,6" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="რჩევა: სახეს მხოლოდ ანფასში და პროფილში პოულობს. თუ ვიდეოში ადამიანი ზურგით ტრიალდება ან სახე იფარება, შეამოწმე შედეგი გადახვევით, სანამ გადააგდებ."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
