<Window x:Class="AiAssistant.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1Flow AiAssistant — პირველი გაშვება"
        Width="640" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="{DynamicResource BgApp}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}">

    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Background="{DynamicResource BgPanel}">
        <Grid Margin="30,26,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid MouseLeftButtonDown="Header_Drag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="15" Background="{DynamicResource AccentSoft}"
                        BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,16,0">
                    <Path Data="{StaticResource Icon.Download}" Fill="{DynamicResource Accent}" Stretch="Uniform"
                          Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="1Flow AiAssistant" FontSize="13" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTitle" Text="ვამზადებ პროგრამას პირველი გამოყენებისთვის" FontSize="19"
                               FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" x:Name="TxtSub" Margin="0,16,0,0" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="ზოგი დიდი კომპონენტი (ffmpeg, AI მოდელები) პროგრამასთან ერთად არ მოდის — ერთხელ ჩამოვტვირთავ და შემდეგ უკვე ჩართვისას არაფერი დაგჭირდება. ინტერნეტი საჭიროა."/>

            <!-- items -->
            <StackPanel Grid.Row="2" x:Name="ItemsPanel" Margin="0,20,0,0"/>

            <!-- footer -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooter" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"/>
                <Button Grid.Column="1" x:Name="BtnRetry" Style="{StaticResource PrimaryButton}" Content="თავიდან ცდა"
                        Padding="20,10" Margin="12,0,0,0" Visibility="Collapsed" Click="BtnRetry_Click"/>
                <Button Grid.Column="2" x:Name="BtnSkip" Style="{StaticResource SecondaryButton}" Content="გამოტოვება"
                        Padding="20,10" Margin="10,0,0,0" Click="BtnSkip_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
