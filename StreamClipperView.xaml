<UserControl x:Class="AiAssistant.StreamClipperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT PANEL: stream → monitor → clip ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="24,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header -->
                    <RowDefinition Height="Auto"/>   <!-- url bar -->
                    <RowDefinition Height="*"/>      <!-- monitor -->
                    <RowDefinition Height="Auto"/>   <!-- stats -->
                    <RowDefinition Height="Auto"/>   <!-- clip bar -->
                </Grid.RowDefinitions>

                <!-- ── HEADER ──────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Videocam}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Live Clipper" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="ჩასვი ლაივის ლინკი — ფონში იწერება, ერთი დაჭერით ბოლო წამები კლიპად იჭრება"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotLive" Width="8" Height="8" Fill="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtLiveChip" Text="გამორთულია" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── URL BAR ─────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Height="50" CornerRadius="13" Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtStreamUrl" Background="Transparent" BorderThickness="0"
                                     Padding="0,0,8,0" FontSize="14" VerticalContentAlignment="Center"
                                     KeyDown="TxtStreamUrl_KeyDown"/>
                            <TextBlock Grid.Column="1" Text="YouTube Live / Facebook Live / m3u8 ლინკი…" FontSize="14"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtStreamUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="&#xE77F;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14" Width="36" Height="36" Padding="0"
                                    Margin="0,0,7,0" ToolTip="ბუფერიდან ჩასმა" Click="BtnPasteUrl_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Button x:Name="BtnStartMonitor" Style="{StaticResource PrimaryButton}" Height="50" Padding="26,0"
                                Click="BtnStartMonitor_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="ჩაწერის დაწყება" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnStopMonitor" Style="{StaticResource DangerButton}" Height="50" Padding="26,0"
                                Visibility="Collapsed" Click="BtnStopMonitor_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="გაჩერება" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- quality row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Collapsed"/>

                <!-- ── MONITOR ─────────────────────────────────────── -->
                <Border Grid.Row="2" Margin="0,16,0,0" CornerRadius="16" Background="{DynamicResource VideoBg}"
                        ClipToBounds="True" MinHeight="180">
                    <Grid>
                        <Image x:Name="ImgLive" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel x:Name="PlaceholderLive" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                <Ellipse Fill="{DynamicResource AccentSoft}"/>
                                <Ellipse Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" Margin="9"/>
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TxtPlaceholderTitle" Text="ლაივი ჯერ არ არის ჩართული" FontSize="17"
                                       FontWeight="SemiBold" Foreground="#E6E8EC" Margin="0,18,0,0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlaceholderSub"
                                       Text="ჩასვი ლინკი და დააჭირე „ჩაწერის დაწყება“ — მერე კლიპს ღილაკით ან C ღილაკით გადაჭრი"
                                       Foreground="#8A919C" FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"/>
                        </StackPanel>

                        <!-- top overlays -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="14,14,0,0">
                            <Border x:Name="LiveBadge" Background="#E5202E" CornerRadius="8" Padding="10,5"
                                    Visibility="Collapsed" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TitleBadge" Background="#CC0B0D10" CornerRadius="8" Padding="11,5"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TxtStreamTitle" FontSize="12" Foreground="#E6E8EC"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                            </Border>
                        </StackPanel>

                        <!-- mark chip -->
                        <Border x:Name="MarkChip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                Background="#CC0B0D10" BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                CornerRadius="8" Padding="11,5" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource Warning}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtMarkChip" FontSize="12" Foreground="#E6E8EC" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── STATS ───────────────────────────────────────── -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileCard}" Margin="0" Padding="16,11">
                        <StackPanel>
                            <TextBlock Text="ჩაწერილი" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtRecordedTime" Text="0:00:00" FontSize="22" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource TileCard}" Margin="0" Padding="16,11">
                        <StackPanel>
                            <TextBlock Text="ბუფერში (ხელმისაწვდომი)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtBufferTime" Text="0:00" FontSize="22" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource TileCard}" Margin="0" Padding="16,11">
                        <StackPanel>
                            <TextBlock Text="დისკზე" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtBufferSize" Text="0 MB" FontSize="22" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── CLIP BAR ────────────────────────────────────── -->
                <Border Grid.Row="4" Margin="0,14,0,0" CornerRadius="14" Padding="16,14"
                        Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ბოლო" FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Grid.Column="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Clip15" GroupName="ClipDur" Tag="15" Style="{StaticResource SpeedSegment}"
                                                 Content="15 წმ" Padding="12,7" Margin="0" Click="Dur_Changed"/>
                                    <RadioButton x:Name="Clip30" GroupName="ClipDur" Tag="30" IsChecked="True"
                                                 Style="{StaticResource SpeedSegment}" Content="30 წმ" Padding="12,7" Margin="0"
                                                 Click="Dur_Changed"/>
                                    <RadioButton x:Name="Clip60" GroupName="ClipDur" Tag="60" Style="{StaticResource SpeedSegment}"
                                                 Content="60 წმ" Padding="12,7" Margin="0" Click="Dur_Changed"/>
                                    <RadioButton x:Name="Clip90" GroupName="ClipDur" Tag="90" Style="{StaticResource SpeedSegment}"
                                                 Content="90 წმ" Padding="12,7" Margin="0" Click="Dur_Changed"/>
                                    <RadioButton x:Name="Clip120" GroupName="ClipDur" Tag="120" Style="{StaticResource SpeedSegment}"
                                                 Content="2 წთ" Padding="12,7" Margin="0" Click="Dur_Changed"/>
                                    <RadioButton x:Name="Clip300" GroupName="ClipDur" Tag="300" Style="{StaticResource SpeedSegment}"
                                                 Content="5 წთ" Padding="12,7" Margin="0" Click="Dur_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnClip" Style="{StaticResource GlowPrimaryButton}" Height="58"
                                    IsEnabled="False" Click="BtnClip_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtClipLabel" Text="კლიპი — ბოლო 30 წამი" FontSize="16"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="#33FFFFFF" CornerRadius="6" Padding="7,2" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="C" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" x:Name="BtnMark" Style="{StaticResource SecondaryButton}" Height="58"
                                    Padding="20,0" IsEnabled="False" Click="BtnMark_Click"
                                    ToolTip="მონიშნე საწყისი — მერე კლიპი იქნება მონიშვნიდან ახლამდე (M)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtMarkLabel" Text="მონიშვნა" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ RIGHT PANEL: settings + clips ═══════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20,20,14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,6,0">
                    <TextBlock Text="პარამეტრები" Style="{StaticResource SectionLabel}"/>

                    <TextBlock Text="ხარისხი" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,0,12">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="QBest" GroupName="LiveQ" Tag="best" IsChecked="True"
                                         Style="{StaticResource SpeedSegment}" Content="ავტო" Padding="4,8" Margin="0"
                                         Click="Quality_Changed"/>
                            <RadioButton GroupName="LiveQ" Tag="1080" Style="{StaticResource SpeedSegment}"
                                         Content="1080p" Padding="4,8" Margin="0" Click="Quality_Changed"/>
                            <RadioButton GroupName="LiveQ" Tag="720" Style="{StaticResource SpeedSegment}"
                                         Content="720p" Padding="4,8" Margin="0" Click="Quality_Changed"/>
                            <RadioButton GroupName="LiveQ" Tag="480" Style="{StaticResource SpeedSegment}"
                                         Content="480p" Padding="4,8" Margin="0" Click="Quality_Changed"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="რამდენ ხანს ვინახავ ბუფერს" FontSize="12" Foreground="{DynamicResource TextMuted}"
                               Margin="2,0,0,6"/>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,0,12">
                        <UniformGrid Rows="1">
                            <RadioButton GroupName="LiveBuf" Tag="5" Style="{StaticResource SpeedSegment}"
                                         Content="5 წთ" Padding="4,8" Margin="0" Click="Buffer_Changed"/>
                            <RadioButton x:Name="Buf10" GroupName="LiveBuf" Tag="10" IsChecked="True"
                                         Style="{StaticResource SpeedSegment}" Content="10 წთ" Padding="4,8" Margin="0"
                                         Click="Buffer_Changed"/>
                            <RadioButton GroupName="LiveBuf" Tag="30" Style="{StaticResource SpeedSegment}"
                                         Content="30 წთ" Padding="4,8" Margin="0" Click="Buffer_Changed"/>
                            <RadioButton GroupName="LiveBuf" Tag="60" Style="{StaticResource SpeedSegment}"
                                         Content="60 წთ" Padding="4,8" Margin="0" Click="Buffer_Changed"/>
                        </UniformGrid>
                    </Border>

                    <Border Style="{StaticResource TileCard}" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkAutoVertical" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                  Click="Option_Changed">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ავტო-ვერტიკალი" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="კლიპი გადავა ვერტიკალში" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource TileCard}" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkAutoEditor" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ავტო-მონტაჟი" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="კლიპი გაიხსნება მინი მონტაჟში" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource TileCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtClipFolder" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="შეცვლა"
                                    Padding="12,7" FontSize="12" Margin="10,0,6,0" Click="BtnChooseFolder_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE838;" Width="34"
                                    Height="34" ToolTip="საქაღალდის გახსნა" Click="BtnOpenFolder_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="გადაჭრილი კლიპები" Style="{StaticResource SectionLabel}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock x:Name="TxtNoClips" Text="კლიპები ჯერ არ არის — ჩართე ლაივი და დააჭირე კლიპის ღილაკს."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="2,2,0,0"/>
                        <StackPanel x:Name="ClipsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
