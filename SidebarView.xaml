<UserControl x:Class="AiAssistant.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiAssistant"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Nav item: Tag = icon glyph (Segoe MDL2), CommandParameter = tab index -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SidebarNav"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="local:Ui.IconColor" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12" Background="Transparent" Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <!-- icon tile: tinted rounded square, solid + white glyph when selected -->
                                    <Grid Width="34" Height="34">
                                        <Border x:Name="TileBg" CornerRadius="11" Opacity="0.16"
                                                Background="{Binding Path=(local:Ui.IconColor), RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Border x:Name="TileBd" CornerRadius="11" BorderThickness="1" Opacity="0.38"
                                                BorderBrush="{Binding Path=(local:Ui.IconColor), RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Path x:Name="Ico" Width="19" Height="19" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                              Fill="{Binding Path=(local:Ui.IconColor), RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Grid>
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="20" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" CornerRadius="0,3,3,0" Margin="-12,0,0,0"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                                <Setter TargetName="TileBg" Property="Opacity" Value="0.28"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TileBg" Property="Opacity" Value="1"/>
                                <Setter TargetName="TileBd" Property="Opacity" Value="0"/>
                                <Setter TargetName="Ico" Property="Fill" Value="{DynamicResource OnAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,18,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,0">
                <TextBlock Text="შექმნა" Style="{StaticResource NavSection}" Margin="12,8,0,6"/>
                <RadioButton x:Name="NavCrop" Style="{StaticResource NavItem}" Tag="&#xE7A8;" CommandParameter="0" local:Ui.Icon="{StaticResource Icon.Crop}" local:Ui.IconColor="{DynamicResource Accent}"
                             IsChecked="True" Content="გავერტიკალურება" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8C6;" CommandParameter="1" local:Ui.Icon="{StaticResource Icon.Cut}" local:Ui.IconColor="{DynamicResource Warning}"
                             Content="მინი მონტაჟი" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8B9;" CommandParameter="6" local:Ui.Icon="{StaticResource Icon.Wallpaper}" local:Ui.IconColor="{DynamicResource Info}"
                             Content="AI ფონი" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE72E;" CommandParameter="9" local:Ui.Icon="{StaticResource Icon.Face}" local:Ui.IconColor="{DynamicResource Success}"
                             Content="სახის დაბუნდოვნება" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE720;" CommandParameter="10" local:Ui.Icon="{StaticResource Icon.Mic}" local:Ui.IconColor="{DynamicResource Accent}"
                             Content="ხმის ჩაწერა" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8AB;" CommandParameter="7" local:Ui.Icon="{StaticResource Icon.Compare}" local:Ui.IconColor="{DynamicResource Warning}"
                             Content="A/B მონიტორი" Checked="Nav_Click"/>

                <TextBlock Text="წყაროები" Style="{StaticResource NavSection}"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE896;" CommandParameter="3" local:Ui.Icon="{StaticResource Icon.Download}" local:Ui.IconColor="{DynamicResource Info}"
                             Content="გადმოწერა" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE714;" CommandParameter="8" local:Ui.Icon="{StaticResource Icon.Videocam}" local:Ui.IconColor="{DynamicResource Accent}"
                             Content="Live Clipper" Checked="Nav_Click"/>

                <TextBlock Text="ბიბლიოთეკა" Style="{StaticResource NavSection}"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" CommandParameter="4" local:Ui.Icon="{StaticResource Icon.Palette}" local:Ui.IconColor="{DynamicResource Warning}"
                             Content="ბრენდ-კიტი" Checked="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8F1;" CommandParameter="5" local:Ui.Icon="{StaticResource Icon.Library}" local:Ui.IconColor="{DynamicResource Success}"
                             Content="მედია ბიბლიოთეკა" Checked="Nav_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: settings, theme switch, version -->
        <StackPanel Grid.Row="1" Margin="12,0">
            <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="4,8,4,8"/>
            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" CommandParameter="2" local:Ui.Icon="{StaticResource Icon.Settings}" local:Ui.IconColor="{DynamicResource TextSecondary}"
                         Content="სეთინგები" Checked="Nav_Click"/>
            <Button x:Name="BtnTheme" Click="BtnTheme_Click" Margin="0,4,0,0" HorizontalContentAlignment="Left"
                    Style="{StaticResource GhostButton}" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Margin="-4,-7,0,-7">
                        <Path x:Name="ThemeIcon" Width="19" Height="19" Stretch="Uniform"
                              Fill="{DynamicResource Warning}" Data="{StaticResource Icon.Sun}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ThemeLabel" Text="ღია თემა" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="v1.2.0" Foreground="{DynamicResource TextMuted}" FontSize="11"
                       Margin="14,10,0,2"/>
        </StackPanel>
    </Grid>
</UserControl>
