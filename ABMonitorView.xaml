<UserControl x:Class="AiAssistant.ABMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT PANEL: stage + transport ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="24,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>        <!-- header + view mode -->
                    <RowDefinition Height="*" MinHeight="180"/>  <!-- stage -->
                    <RowDefinition Height="Auto"/>        <!-- seek -->
                    <RowDefinition Height="Auto"/>        <!-- transport -->
                </Grid.RowDefinitions>

                <!-- ── HEADER ─────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Compare}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="A/B მონიტორი" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="შეადარე ორიგინალი და დამუშავებული ვიდეო — კადრი კადრზე, ერთ ტაიმლაინზე"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="12" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbModeSide" GroupName="AbMode" IsChecked="True"
                                         Style="{StaticResource SpeedSegment}" Content="გვერდიგვერდ"
                                         Padding="13,7" FontSize="12.5" Margin="0" Click="Mode_Changed"
                                         ToolTip="ორივე ვიდეო ერთმანეთის გვერდით (1)"/>
                            <RadioButton x:Name="RbModeWipe" GroupName="AbMode"
                                         Style="{StaticResource SpeedSegment}" Content="გაყოფა"
                                         Padding="13,7" FontSize="12.5" Margin="0" Click="Mode_Changed"
                                         ToolTip="ერთ კადრში, გადასათრევი გამყოფით (2)"/>
                            <RadioButton x:Name="RbModeFlip" GroupName="AbMode"
                                         Style="{StaticResource SpeedSegment}" Content="გადართვა"
                                         Padding="13,7" FontSize="12.5" Margin="0" Click="Mode_Changed"
                                         ToolTip="A ↔ B ერთსა და იმავე ადგილას (3, გადასართავად X)"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── STAGE ──────────────────────────────────────────── -->
                <Border Grid.Row="1" x:Name="StageFrame" Margin="0,18,0,14" CornerRadius="14"
                        Background="{DynamicResource VideoBg}" ClipToBounds="True">
                    <Grid x:Name="Stage" Background="Transparent"
                          MouseWheel="Stage_MouseWheel"
                          MouseLeftButtonDown="Stage_MouseDown" MouseMove="Stage_MouseMove"
                          MouseLeftButtonUp="Stage_MouseUp" SizeChanged="Stage_SizeChanged"
                          MouseRightButtonDown="Stage_ResetZoom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- A pane -->
                        <Border x:Name="PaneA" Grid.Column="0" ClipToBounds="True" AllowDrop="True"
                                Background="{DynamicResource VideoBg}"
                                DragEnter="Pane_DragEnter" DragOver="Pane_DragEnter" DragLeave="Pane_DragLeave" Drop="PaneA_Drop">
                            <Grid>
                                <MediaElement x:Name="MediaA" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" ScrubbingEnabled="True"
                                              MediaOpened="MediaA_Opened" MediaFailed="MediaA_Failed"/>
                                <StackPanel x:Name="PlaceholderA" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SuccessSoft}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="A" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Success}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ორიგინალი" FontSize="15" FontWeight="SemiBold" Foreground="#E6E8EC"
                                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="გადმოათრიე ვიდეო ან აირჩიე" FontSize="12" Foreground="#8A919C"
                                               Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="ვიდეოს არჩევა" Padding="18,9"
                                            Margin="0,14,0,0" HorizontalAlignment="Center" Click="BtnPickA_Click"/>
                                </StackPanel>
                                <Border x:Name="BadgeA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                                        Background="#CC0B0D10" CornerRadius="9" Padding="10,5" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" Margin="0,0,7,0"/>
                                        <TextBlock Text="A · ორიგინალი" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6E8EC"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- B pane -->
                        <Border x:Name="PaneB" Grid.Column="2" ClipToBounds="True" AllowDrop="True"
                                Background="{DynamicResource VideoBg}"
                                DragEnter="Pane_DragEnter" DragOver="Pane_DragEnter" DragLeave="Pane_DragLeave" Drop="PaneB_Drop">
                            <Grid>
                                <MediaElement x:Name="MediaB" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" ScrubbingEnabled="True" Volume="0"
                                              MediaOpened="MediaB_Opened" MediaFailed="MediaB_Failed"/>
                                <StackPanel x:Name="PlaceholderB" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource InfoSoft}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="B" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Info}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="დამუშავებული" FontSize="15" FontWeight="SemiBold" Foreground="#E6E8EC"
                                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="გადმოათრიე ვიდეო ან აირჩიე" FontSize="12" Foreground="#8A919C"
                                               Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="ვიდეოს არჩევა" Padding="18,9"
                                            Margin="0,14,0,0" HorizontalAlignment="Center" Click="BtnPickB_Click"/>
                                </StackPanel>
                                <Border x:Name="BadgeB" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                        Background="#CC0B0D10" CornerRadius="9" Padding="10,5" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Info}" Margin="0,0,7,0"/>
                                        <TextBlock Text="B · დამუშავებული" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6E8EC"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- wipe divider (only in wipe mode) -->
                        <Canvas x:Name="WipeLayer" Grid.ColumnSpan="3" Panel.ZIndex="10" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle x:Name="WipeLine" Width="2" Fill="White" Opacity="0.9"/>
                            <Border x:Name="WipeGrip" Width="34" Height="34" CornerRadius="17" Background="White">
                                <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#15191F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>

                        <!-- zoom indicator -->
                        <Border x:Name="ZoomChip" Grid.ColumnSpan="3" Panel.ZIndex="11" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,12" Background="#CC0B0D10" CornerRadius="10" Padding="11,5"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="TxtZoomChip" Text="200%" FontSize="12" FontWeight="SemiBold" Foreground="#E6E8EC"/>
                        </Border>

                        <!-- drag highlight -->
                        <Border x:Name="DropHint" Grid.ColumnSpan="3" Panel.ZIndex="12" Visibility="Collapsed" IsHitTestVisible="False"
                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                                BorderThickness="2" CornerRadius="14"/>
                    </Grid>
                </Border>

                <!-- ── SEEK ───────────────────────────────────────────── -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtABCurrent" Text="0:00.00" FontFamily="Consolas" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Grid.Column="1" x:Name="SlABSeek" Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True" IsEnabled="False" ValueChanged="SlABSeek_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TxtABTotal" Text="0:00.00" FontFamily="Consolas" FontSize="13"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <!-- ── TRANSPORT ──────────────────────────────────────── -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnABPlay" Style="{StaticResource PrimaryButton}" Content="&#xE768;"
                                FontFamily="Segoe MDL2 Assets" FontSize="16" Width="46" Height="46" Padding="0"
                                IsEnabled="False" ToolTip="დაკვრა / პაუზა (Space)" Click="BtnABPlay_Click"/>
                        <Button x:Name="BtnABRewind" Style="{StaticResource ToolButton}" Content="&#xE892;" Height="46"
                                Margin="8,0,0,0" IsEnabled="False" ToolTip="დასაწყისში (Home)" Click="BtnABRewind_Click"/>
                        <Button x:Name="BtnABPrev" Style="{StaticResource ToolButton}" Content="&#xE76B;" Height="46"
                                Margin="6,0,0,0" IsEnabled="False" ToolTip="წინა კადრი (←)" Click="BtnABPrev_Click"/>
                        <Button x:Name="BtnABNext" Style="{StaticResource ToolButton}" Content="&#xE76C;" Height="46"
                                Margin="6,0,0,0" IsEnabled="False" ToolTip="შემდეგი კადრი (→)" Click="BtnABNext_Click"/>
                        <Button x:Name="BtnABLoop" Style="{StaticResource ToolButton}" Content="&#xE8EE;" Height="46"
                                Margin="6,0,0,0" Tag="on" ToolTip="ციკლური დაკვრა (L)" Click="BtnABLoop_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock x:Name="TxtABStatus" Text="ორივე ვიდეო აირჩიე შესადარებლად" FontSize="12.5"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnABSnap" Style="{StaticResource SecondaryButton}" Height="46" Padding="16,0"
                                IsEnabled="False" ToolTip="მიმდინარე შედარების კადრის შენახვა PNG-ად (S)"
                                Click="BtnABSnap_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="კადრის შენახვა" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ RIGHT PANEL: files, sync, tools, analysis ═══════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="22,22,16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,6,16">
                    <TextBlock Text="შედარების პარამეტრები" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="ფაილები, სინქრონი და ხარისხის გაზომვა" FontSize="12.5"
                               Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <!-- file A -->
                        <Border Style="{StaticResource TileCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SuccessSoft}"
                                        VerticalAlignment="Top" Margin="0,0,12,0">
                                    <TextBlock Text="A" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Success}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPathA" Text="ორიგინალი ვიდეო" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtMetaA" Text="ფაილი არ არის არჩეული" FontSize="11.5"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE838;"
                                        Width="34" Height="34" Margin="10,0,0,0" VerticalAlignment="Top"
                                        ToolTip="A ვიდეოს არჩევა" Click="BtnPickA_Click"/>
                            </Grid>
                        </Border>

                        <!-- swap -->
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,-4,0,6"
                                Padding="12,5" FontSize="12" Click="BtnSwap_Click" ToolTip="A და B ადგილების გაცვლა">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="A ↔ B გაცვლა" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- file B -->
                        <Border Style="{StaticResource TileCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource InfoSoft}"
                                        VerticalAlignment="Top" Margin="0,0,12,0">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Info}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPathB" Text="დამუშავებული ვიდეო" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtMetaB" Text="ფაილი არ არის არჩეული" FontSize="11.5"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE838;"
                                        Width="34" Height="34" Margin="10,0,0,0" VerticalAlignment="Top"
                                        ToolTip="B ვიდეოს არჩევა" Click="BtnPickB_Click"/>
                            </Grid>
                        </Border>

                        <!-- difference summary -->
                        <Border x:Name="DiffCard" Style="{StaticResource TileCard}" Visibility="Collapsed"
                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}">
                            <TextBlock x:Name="TxtDiff" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" LineHeight="19"/>
                        </Border>

                        <!-- audio -->
                        <TextBlock Text="ხმა" Style="{StaticResource SectionLabel}" Margin="2,10,0,8"/>
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbAudA" GroupName="AbAudio" IsChecked="True"
                                             Style="{StaticResource SpeedSegment}" Content="A" Padding="18,7" Margin="0"
                                             Click="Audio_Changed"/>
                                <RadioButton x:Name="RbAudB" GroupName="AbAudio"
                                             Style="{StaticResource SpeedSegment}" Content="B" Padding="18,7" Margin="0"
                                             Click="Audio_Changed"/>
                                <RadioButton x:Name="RbAudOff" GroupName="AbAudio"
                                             Style="{StaticResource SpeedSegment}" Content="გამორთვა" Padding="14,7" Margin="0"
                                             Click="Audio_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- speed -->
                        <TextBlock Text="სიჩქარე" Style="{StaticResource SectionLabel}" Margin="2,16,0,8"/>
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="AbSpeed" Tag="0.25" Style="{StaticResource SpeedSegment}"
                                             Content="0.25×" Padding="12,7" Margin="0" Click="Speed_Changed"/>
                                <RadioButton GroupName="AbSpeed" Tag="0.5" Style="{StaticResource SpeedSegment}"
                                             Content="0.5×" Padding="12,7" Margin="0" Click="Speed_Changed"/>
                                <RadioButton GroupName="AbSpeed" Tag="1" IsChecked="True" Style="{StaticResource SpeedSegment}"
                                             Content="1×" Padding="14,7" Margin="0" Click="Speed_Changed"/>
                                <RadioButton GroupName="AbSpeed" Tag="2" Style="{StaticResource SpeedSegment}"
                                             Content="2×" Padding="14,7" Margin="0" Click="Speed_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- zoom -->
                        <TextBlock Text="გადიდება (ორივეზე ერთდროულად)" Style="{StaticResource SectionLabel}" Margin="2,16,0,8"/>
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbZoom1" GroupName="AbZoom" Tag="1" IsChecked="True"
                                             Style="{StaticResource SpeedSegment}" Content="მთლიანი" Padding="12,7" Margin="0"
                                             Click="ZoomPreset_Click"/>
                                <RadioButton GroupName="AbZoom" Tag="2" Style="{StaticResource SpeedSegment}"
                                             Content="2×" Padding="14,7" Margin="0" Click="ZoomPreset_Click"/>
                                <RadioButton GroupName="AbZoom" Tag="4" Style="{StaticResource SpeedSegment}"
                                             Content="4×" Padding="14,7" Margin="0" Click="ZoomPreset_Click"/>
                                <RadioButton GroupName="AbZoom" Tag="8" Style="{StaticResource SpeedSegment}"
                                             Content="8×" Padding="14,7" Margin="0" Click="ZoomPreset_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ბორბალი — გადიდება, გადათრევა — გადაადგილება, მარჯვენა ღილაკი — საწყისი"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="2,8,0,0"/>

                        <!-- sync offset -->
                        <TextBlock Text="B-ს სინქრონი (წანაცვლება)" Style="{StaticResource SectionLabel}" Margin="2,18,0,8"/>
                        <Border Style="{StaticResource TileCard}" Padding="12,10" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="−1ფ" Padding="9,7"
                                        FontSize="12" Tag="-1f" Click="Offset_Click" ToolTip="B ერთი კადრით ადრე"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="−100" Padding="9,7"
                                        FontSize="12" Tag="-100" Margin="6,0,0,0" Click="Offset_Click" ToolTip="B 100 მს ადრე"/>
                                <TextBlock Grid.Column="2" x:Name="TxtOffset" Text="0 მს" FontFamily="Consolas" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="+100" Padding="9,7"
                                        FontSize="12" Tag="100" Margin="0,0,6,0" Click="Offset_Click" ToolTip="B 100 მს გვიან"/>
                                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="+1ფ" Padding="9,7"
                                        FontSize="12" Tag="1f" Click="Offset_Click" ToolTip="B ერთი კადრით გვიან"/>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Content="წანაცვლების განულება" FontSize="12"
                                Padding="10,5" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Offset_Reset"/>

                        <!-- analysis -->
                        <TextBlock Text="ხარისხის გაზომვა" Style="{StaticResource SectionLabel}" Margin="2,18,0,8"/>
                        <Border Style="{StaticResource TileCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ადარებს B-ს A-სთან კადრ-კადრ (SSIM და PSNR) — ხედავ, რამდენად შეიცვალა სურათი."
                                           FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <Button x:Name="BtnAnalyze" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                                        Padding="14,10" IsEnabled="False" Click="BtnAnalyze_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Margin="0,0,9,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock x:Name="TxtAnalyzeBtn" Text="გაზომვა" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ProgressBar x:Name="PbAnalyze" Height="5" Margin="0,12,0,0" Visibility="Collapsed"
                                             Minimum="0" Maximum="100"/>
                                <StackPanel x:Name="AnalyzeResult" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource BgInput}" CornerRadius="10" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="SSIM" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock x:Name="TxtSsim" Text="—" FontSize="22" FontWeight="SemiBold"
                                                           FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource BgInput}" CornerRadius="10" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="PSNR" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock x:Name="TxtPsnr" Text="—" FontSize="22" FontWeight="SemiBold"
                                                           FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="TxtVerdict" FontSize="12.5" FontWeight="SemiBold" Margin="0,12,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
