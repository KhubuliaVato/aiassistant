<Window x:Class="AiAssistant.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ექსპორტის პარამეტრები" Height="340" Width="500"
        Background="#151A1F" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="Button" x:Key="BlueButton">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10,20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0070E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10,20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22282D"/>
            <Setter Property="Foreground" Value="#F9F8F9"/>
            <Setter Property="BorderBrush" Value="#4DCD0F20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,12,10,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#0A84FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="ვიდეოს ექსპორტი (9:16)" Foreground="#F9F8F9" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="მიუთითეთ ფაილის სახელი და შენახვის ადგილი." Foreground="#99F9F8F9" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- File name -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="ფაილის სახელი" Foreground="#99F9F8F9" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <TextBox x:Name="TxtFileName"/>
            </StackPanel>

            <!-- Output folder -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="შენახვის საქაღალდე" Foreground="#99F9F8F9" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Read-only folder path display -->
                    <Border Grid.Column="0" Background="#22282D" BorderBrush="#4DCD0F20"
                            BorderThickness="1" CornerRadius="6" Padding="10,0">
                        <TextBlock x:Name="TxtFolderDisplay"
                                   Foreground="#F9F8F9" FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Border>

                    <!-- Browse button -->
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Content="📁 შეცვლა"
                            Padding="14,12,14,12" FontSize="13"
                            Click="BtnBrowseFolder_Click"/>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="გაუქმება" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Style="{StaticResource BlueButton}" Content="🎬 ექსპორტი" Click="BtnExport_Click" IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
