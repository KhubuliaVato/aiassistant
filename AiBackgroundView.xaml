<UserControl x:Class="AiAssistant.AiBackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ LEFT: stage ═══════════════ -->
        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="24,22" AllowDrop="True"
                DragEnter="Drag_Enter" DragOver="Drag_Enter" DragLeave="Drag_Leave" Drop="Drag_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header -->
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- preview -->
                    <RowDefinition Height="Auto"/>   <!-- timeline -->
                    <RowDefinition Height="Auto"/>   <!-- action bar -->
                    <RowDefinition Height="Auto"/>   <!-- status -->
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Wallpaper}" Fill="{DynamicResource Accent}" Stretch="Uniform"
                              Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AI ფონი" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="აირჩიე ვინ ან რა დარჩეს კადრში — დანარჩენს AI ახალ ფონზე გადაიტანს"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotAi" Width="8" Height="8" Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtAi" Text="AI მოწმდება…" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- toolbar: what to look at · tools -->
                <Grid Grid.Row="1" x:Name="Toolbar" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="12" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ViewResult" GroupName="BgView" IsChecked="True" Style="{StaticResource SpeedSegment}"
                                         Content="შედეგი" Padding="14,7" FontSize="12.5" Margin="0" Click="View_Changed"
                                         ToolTip="ასე გამოიყურება დამუშავებული ვიდეო"/>
                            <RadioButton x:Name="ViewOriginal" GroupName="BgView" Style="{StaticResource SpeedSegment}"
                                         Content="ორიგინალი" Padding="14,7" FontSize="12.5" Margin="0" Click="View_Changed"/>
                            <RadioButton x:Name="ViewHighlight" GroupName="BgView" Style="{StaticResource SpeedSegment}"
                                         Content="რა შეიცვლება" Padding="14,7" FontSize="12.5" Margin="0" Click="View_Changed"
                                         ToolTip="წითლად ჩანს ის, რაც ახალ ფონზე გადავა · თეთრი ხაზი = დარჩენილის კონტური"/>
                            <RadioButton x:Name="ViewMatte" GroupName="BgView" Style="{StaticResource SpeedSegment}"
                                         Content="მასკა" Padding="14,7" FontSize="12.5" Margin="0" Click="View_Changed"
                                         ToolTip="თეთრი = რჩება · შავი = იცვლება"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="12" Padding="3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ToolSelect" GroupName="BgTool" IsChecked="True" Style="{StaticResource SpeedSegment}"
                                             Padding="12,7" FontSize="12.5" Margin="0" Click="Tool_Changed"
                                             ToolTip="არჩევა: დააჭირე ადამიანს ჩარჩოზე — ჩაირთვება/გამოირთვება · მონიშნულ ჩარჩოს გადაათრევ ან ზომას შეუცვლი">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2196;" FontSize="15" FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="არჩევა" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ToolMark" GroupName="BgTool" Style="{StaticResource SpeedSegment}"
                                             Padding="12,7" FontSize="12.5" Margin="0" Click="Tool_Changed"
                                             ToolTip="მონიშვნა: გადაათრიე მართკუთხედი ადამიანზე ან ობიექტზე — პროგრამა თვითონ მიჰყვება მთელ ვიდეოში">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="მონიშვნა" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <ComboBox x:Name="CmbMarkType" Width="150" Height="36" SelectedIndex="0" VerticalContentAlignment="Center"
                                  ToolTip="რას ვნიშნავ: ადამიანს AI-ით, ნებისმიერ ობიექტს ავტო-მოჭრით, ან უბრალოდ ფორმას"
                                  SelectionChanged="MarkType_Changed">
                            <ComboBoxItem Content="ადამიანი (AI)" Tag="person"/>
                            <ComboBoxItem Content="ობიექტი" Tag="object"/>
                            <ComboBoxItem Content="ფორმა (მართკუთხედი)" Tag="shape"/>
                        </ComboBox>
                        <Button x:Name="BtnChange" Style="{StaticResource SecondaryButton}" Content="ვიდეოს შეცვლა" Padding="14,8"
                                FontSize="12.5" Margin="10,0,0,0" Click="BtnPick_Click"/>
                    </StackPanel>
                </Grid>

                <!-- stage -->
                <Border Grid.Row="2" x:Name="Stage" Margin="0,14,0,12" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource VideoBg}">
                    <Grid>
                        <Image x:Name="PvImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SizeChanged="Stage_SizeChanged"/>
                        <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" Cursor="Arrow"
                                MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"/>

                        <!-- empty state -->
                        <Grid x:Name="DropZone" Margin="22">
                            <Rectangle RadiusX="16" RadiusY="16" Fill="{DynamicResource BgCard}" Stroke="{DynamicResource BorderStrong}"
                                       StrokeThickness="1.2" StrokeDashArray="5 5" IsHitTestVisible="False"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="92" Height="92" HorizontalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSoft}"/>
                                    <Ellipse Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" Margin="10"/>
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="ჩააგდე ვიდეო აქ" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                <TextBlock Text="შემდეგ მონიშნე ვინ დარჩეს — AI დანარჩენს ახალ ფონზე გადაიტანს"
                                           FontSize="12.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="ვიდეოს არჩევა" Click="BtnPick_Click"
                                        HorizontalAlignment="Center" Padding="22,11" Margin="0,22,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- hint chip while a tool is active -->
                        <Border x:Name="HintChip" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                Background="#E60E1115" CornerRadius="16" Padding="14,7" IsHitTestVisible="False">
                            <TextBlock x:Name="TxtHint" FontSize="12.5" Foreground="#E6E8EC"/>
                        </Border>

                        <!-- small busy chip (preview / tracking) -->
                        <Border x:Name="BusyChip" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Background="#E60E1115" CornerRadius="18" Padding="16,9" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BusySpin" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Accent}"
                                           Margin="0,1,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform x:Name="BusyRot"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="TxtBusy" Text="ანალიზი…" FontSize="12.5" Foreground="#E6E8EC"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DragOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource AccentSoft}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="16"/>
                    </Grid>
                </Border>

                <!-- timeline -->
                <Grid Grid.Row="3" x:Name="TimelineBox" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTime" Text="0:00" FontFamily="Consolas" FontSize="12.5" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Grid.Column="1" x:Name="SlTime" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="SlTime_Changed"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TxtTotal" Text="0:00" FontFamily="Consolas" FontSize="12.5"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" x:Name="LaneScroll" Margin="0,8,0,0" MaxHeight="124"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="LaneBadges" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <Canvas Grid.Column="1" x:Name="Lanes" Background="Transparent" Cursor="Hand" SnapsToDevicePixels="True"
                                    SizeChanged="Lanes_SizeChanged" MouseLeftButtonDown="Lanes_MouseDown" MouseMove="Lanes_MouseMove"
                                    MouseLeftButtonUp="Lanes_MouseUp" MouseRightButtonUp="Lanes_RightUp"
                                    ToolTip="დააჭირე — გადახვალ ამ მომენტზე · ქვედა ზოლზე გადათრევით მონიშნე მონაკვეთი, სადაც ორიგინალი უნდა დარჩეს · მარჯვენა კლავიში — წაშლა"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- action bar -->
                <Border Grid.Row="4" Style="{StaticResource TileCard}" Margin="0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" Margin="0,0,14,0">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFile" Text="ვიდეო არ არის არჩეული" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtMeta" Text="აირჩიე ვიდეო ან გადმოიტანე აქ" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnRefresh" Style="{StaticResource SecondaryButton}" Height="48" Padding="18,0" FontSize="13.5"
                                Margin="14,0,8,0" IsEnabled="False" Click="BtnRefresh_Click" ToolTip="ახლიდან გამოთვლა ამ მომენტისთვის">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="განახლება" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="BtnRender" Style="{StaticResource GlowPrimaryButton}" Height="48" Padding="24,0" FontSize="14"
                                IsEnabled="False" Click="BtnRender_Click" ToolTip="მთელ ვიდეოს დაამუშავებს და ახალ ფაილად შეინახავს">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ფონის შეცვლა" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- status -->
                <Grid Grid.Row="5" Margin="2,12,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Top" Margin="0,5,9,0"/>
                        <TextBlock x:Name="TxtStatus" Text="მზად არის სამუშაოდ" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnCompare" Style="{StaticResource GhostButton}" Content="A/B შედარება" FontSize="12" Padding="12,6"
                                Margin="0,0,6,0" Visibility="Collapsed" Click="BtnCompare_Click"/>
                        <Button x:Name="BtnReveal" Style="{StaticResource GhostButton}" Content="ფოლდერში ჩვენება" FontSize="12" Padding="12,6"
                                Visibility="Collapsed" Click="BtnReveal_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ the render progress: a calm, animated overlay over the whole stage ═══ -->
                <Border x:Name="ProgressLayer" Grid.RowSpan="6" Visibility="Collapsed" Background="#D9090B0F" CornerRadius="16" Margin="-24,-22">
                    <Border Width="560" Padding="34,30" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="68" Height="68" Margin="0,0,20,0">
                                    <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="5"/>
                                    <!-- the arc lives on a 68×68 canvas that turns around its own centre (= the ring's centre) -->
                                    <Canvas x:Name="SpinArc" Width="68" Height="68" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Canvas.RenderTransform><RotateTransform x:Name="ArcRot"/></Canvas.RenderTransform>
                                        <Path Stroke="{DynamicResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 34,2.5 A 31.5,31.5 0 0 1 65.5,34"/>
                                    </Canvas>
                                    <TextBlock x:Name="TxtPctBig" Text="0%" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDoneMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource Success}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPTitle" Text="ფონი იცვლება" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtPSub" Text="AI კადრ-კადრ ამოჭრის და ახალ ფონზე აწყობს" FontSize="12.5"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- animated bar -->
                            <Border Height="10" CornerRadius="5" Margin="0,24,0,0" Background="{DynamicResource BgInput}" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E5202E" Offset="0"/>
                                                <GradientStop Color="#FF5A66" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border x:Name="Shimmer" Width="90" HorizontalAlignment="Left" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.RenderTransform><TranslateTransform x:Name="ShimmerMove" X="-90"/></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="TxtPLeft" Text="იწყება…" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtPEta" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- what is being made right now -->
                            <Border x:Name="LiveBox" Margin="0,20,0,0" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource VideoBg}" Height="190">
                                <Image x:Name="LiveImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button x:Name="BtnPCancel" Style="{StaticResource DangerButton}" Content="გაჩერება" Padding="20,10" Click="BtnPCancel_Click"/>
                                <Button x:Name="BtnPCompare" Style="{StaticResource SecondaryButton}" Content="A/B შედარება" Padding="18,10" Margin="0,0,8,0"
                                        Visibility="Collapsed" Click="BtnCompare_Click"/>
                                <Button x:Name="BtnPReveal" Style="{StaticResource SecondaryButton}" Content="ფოლდერში" Padding="18,10" Margin="0,0,8,0"
                                        Visibility="Collapsed" Click="BtnReveal_Click"/>
                                <Button x:Name="BtnPClose" Style="{StaticResource PrimaryButton}" Content="მზადაა" Padding="22,10"
                                        Visibility="Collapsed" Click="BtnPClose_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ RIGHT: the recipe ═══════════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="22,22,12,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel>

                    <!-- 1 · what stays -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="1" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="რა დარჩეს კადრში" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="დანარჩენი ახალ ფონზე გადავა" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="3">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ModeAll" GroupName="BgSubject" IsChecked="True" Style="{StaticResource SpeedSegment}" Padding="10,9"
                                         FontSize="12.5" Margin="0" Click="Subject_Changed" ToolTip="AI ყველა ადამიანს ტოვებს">
                                <TextBlock Text="ყველა ადამიანი" HorizontalAlignment="Center"/>
                            </RadioButton>
                            <RadioButton x:Name="ModeSel" GroupName="BgSubject" Style="{StaticResource SpeedSegment}" Padding="10,9"
                                         FontSize="12.5" Margin="0" Click="Subject_Changed" ToolTip="რჩება მხოლოდ ის, რასაც აქ ჩართავ ან ხელით მონიშნავ">
                                <TextBlock Text="მხოლოდ არჩეული" HorizontalAlignment="Center"/>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="TxtSubjectHint" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="2,10,2,0"
                               Text="AI ყველა ადამიანს ტოვებს. თუ საჭიროა რომელიმე ობიექტიც (პროდუქტი, ეკრანი…), მონიშნე ის პრევიუზე — „მონიშვნა“."/>

                    <Border x:Name="PeopleBox" Style="{StaticResource TileCard}" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ადამიანები ვიდეოში" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="BtnPeopleAll" Style="{StaticResource GhostButton}" Content="ყველა" Padding="9,4" FontSize="11.5"
                                        Visibility="Collapsed" Click="BtnPeopleAll_Click"/>
                                <Button Grid.Column="2" x:Name="BtnPeopleNone" Style="{StaticResource GhostButton}" Content="არცერთი" Padding="9,4" FontSize="11.5"
                                        Margin="3,0,0,0" Visibility="Collapsed" Click="BtnPeopleNone_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtPeopleHint" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="ჯერ მოძებნე ადამიანები — თითოეულს ფერი და ნომერი მიენიჭება."/>
                            <Button x:Name="BtnFindPeople" Style="{StaticResource SecondaryButton}" Content="ადამიანების ძებნა" Height="40" Margin="0,10,0,0"
                                    Click="BtnFindPeople_Click"/>
                            <ProgressBar x:Name="PbPeople" Height="5" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                            <StackPanel x:Name="PeoplePanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TileCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ხელით მონიშნული" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtMarkCount" Text="" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="TxtMarksHint" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="ჯერ არაფერი მონიშნული არ არის. ჩართე „მონიშვნა“ პრევიუს ზემოთ და გადაათრიე მართკუთხედი ადამიანზე ან ობიექტზე."/>
                            <StackPanel x:Name="MarksPanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2 · the new background -->
                    <Grid Margin="0,24,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="2" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ახალი ფონი" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="რით შევცვალოთ" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="4">
                        <RadioButton x:Name="BgBlur" GroupName="BgMode" IsChecked="True" Style="{StaticResource ModeCard}" Margin="0,0,5,0" Click="BgMode_Changed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Blur" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BgColor" GroupName="BgMode" Style="{StaticResource ModeCard}" Margin="3,0,2,0" Click="BgMode_Changed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="ფერი" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BgImage" GroupName="BgMode" Style="{StaticResource ModeCard}" Margin="2,0,3,0" Click="BgMode_Changed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="სურათი" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BgVideo" GroupName="BgMode" Style="{StaticResource ModeCard}" Margin="5,0,0,0" Click="BgMode_Changed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="ვიდეო" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border x:Name="PanelBlur" Style="{StaticResource TileCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="დაბუნდოვნების სიძლიერე" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtBlur" Text="35" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SlBlur" Minimum="11" Maximum="71" Value="35" TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="Slider_Changed" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanelColor" Style="{StaticResource TileCard}" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ColorSwatch" Background="#E5202E" CornerRadius="10" Height="40" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"/>
                                <TextBox Grid.Column="2" x:Name="TxtColor" Text="#E5202E" FontSize="13.5" VerticalContentAlignment="Center" Height="40"
                                         TextChanged="TxtColor_Changed"/>
                            </Grid>
                            <WrapPanel x:Name="Swatches" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanelFile" Style="{StaticResource TileCard}" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtFileLabel" Text="ფონის ფაილი" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9"
                                        Padding="12,0" Height="40">
                                    <TextBlock x:Name="TxtBgFile" Text="ფაილი არ არის არჩეული…" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="არჩევა" Height="40" Padding="16,0" Click="BtnPickBgFile_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3 · finish -->
                    <Grid Margin="0,24,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="3" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ხარისხი და კიდეები" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="თუ კიდეზე რამე არ მოგწონს — აქ გაასწორებ" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="3">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="QFast" GroupName="BgQuality" Style="{StaticResource SpeedSegment}" Padding="8,9" FontSize="12.5" Margin="0" Click="Option_Changed"
                                         ToolTip="სწრაფი — დიდი და ნათელი ადამიანებისთვის"><TextBlock Text="სწრაფი" HorizontalAlignment="Center"/></RadioButton>
                            <RadioButton x:Name="QBal" GroupName="BgQuality" IsChecked="True" Style="{StaticResource SpeedSegment}" Padding="8,9" FontSize="12.5" Margin="0" Click="Option_Changed"
                                         ToolTip="რეკომენდებული"><TextBlock Text="ბალანსი" HorizontalAlignment="Center"/></RadioButton>
                            <RadioButton x:Name="QMax" GroupName="BgQuality" Style="{StaticResource SpeedSegment}" Padding="8,9" FontSize="12.5" Margin="0" Click="Option_Changed"
                                         ToolTip="მაქსიმუმი — თმა და წვრილი დეტალები, მაგრამ ნელა"><TextBlock Text="მაქსიმუმი" HorizontalAlignment="Center"/></RadioButton>
                        </UniformGrid>
                    </Border>

                    <Border Style="{StaticResource TileCard}" Margin="0,12,0,0">
                        <StackPanel Margin="0,-14,0,0">
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="ხვრელების შევსება" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           ToolTip="როცა ადამიანის შიგნით ფონი „ჩანს“ (მაისურის ფერი ფონს ჰგავს) — AI ავსებს"/>
                                <TextBlock x:Name="TxtSolid" Text="60" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SlSolid" Minimum="0" Maximum="100" Value="60" ValueChanged="Slider_Changed" Margin="0,8,0,0"/>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="კიდის გაწმენდა" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           ToolTip="ძველი ფონის ზოლს ხსნის ადამიანის კონტურიდან"/>
                                <TextBlock x:Name="TxtDefr" Text="60" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SlDefr" Minimum="0" Maximum="100" Value="60" ValueChanged="Slider_Changed" Margin="0,8,0,0"/>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="ციმციმის შემცირება" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtSmooth" Text="30" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SlSmooth" Minimum="0" Maximum="100" Value="30" ValueChanged="Slider_Changed" Margin="0,8,0,0"/>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="კიდე: შიგნით ← → გარეთ" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtGrow" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SlGrow" Minimum="-10" Maximum="10" Value="0" ValueChanged="Slider_Changed" Margin="0,8,0,0"/>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="სირბილე" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtFeather" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SlFeather" Minimum="0" Maximum="100" Value="0" ValueChanged="Slider_Changed" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="საწყისზე დაბრუნება" FontSize="12" Padding="10,6" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="BtnResetRefine_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- more -->
                    <TextBlock Text="ᲙᲘᲓᲔᲕ" Style="{StaticResource SectionLabel}" Margin="2,24,0,10"/>

                    <Border Style="{StaticResource TileCard}">
                        <CheckBox x:Name="ChkInvert" Style="{StaticResource ToggleSwitch}" Click="Option_Changed">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="შებრუნებული ეფექტი" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="ადამიანი იცვლება, ფონი რჩება" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource TileCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="კამერა (Live)" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="ცოცხალი ეფექტი კამერაზე" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnLive" Style="{StaticResource SecondaryButton}" Content="გაშვება" Padding="16,9" FontSize="12.5"
                                    Click="BtnLive_Click" ToolTip="გახსნის კამერის ფანჯარას (დახურვა: ESC)"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TileCard}">
                        <StackPanel>
                            <TextBlock Text="პრეზეტები" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="ფონი + ხარისხი — ერთი დაწკაპუნებით" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPresetName" Height="40" VerticalContentAlignment="Center" ToolTip="პრეზეტის სახელი"/>
                                <TextBlock Text="პრეზეტის სახელი…" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                                           Foreground="{DynamicResource TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtPresetName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="შენახვა" Height="40" Padding="16,0" Click="BtnSavePreset_Click"/>
                            </Grid>
                            <ListBox x:Name="LstPresets" MaxHeight="140" Margin="0,10,0,0" SelectionChanged="LstPresets_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TileCard}">
                        <StackPanel>
                            <TextBlock Text="რამდენიმე ვიდეო ერთად" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="ერთი და იგივე ფონი და ხარისხი (ყველა ადამიანი რჩება)" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            <StackPanel x:Name="BatchPanel" Margin="0,10,0,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="+ ვიდეოების დამატება" Margin="0,10,0,0" Height="40" Click="BtnAddBatch_Click"/>
                            <Button x:Name="BtnBatch" Style="{StaticResource PrimaryButton}" Content="ყველას დამუშავება" Margin="0,8,0,0" Height="42"
                                    IsEnabled="False" Click="BtnBatch_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
