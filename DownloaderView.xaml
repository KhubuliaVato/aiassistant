<UserControl x:Class="AiAssistant.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT PANEL: link → preview → download ═══════════ -->
        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="24,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header -->
                    <RowDefinition Height="Auto"/>   <!-- url bar -->
                    <RowDefinition Height="*"/>      <!-- content -->
                    <RowDefinition Height="Auto"/>   <!-- progress -->
                </Grid.RowDefinitions>

                <!-- ── HEADER ──────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource Icon.Download}" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="გადმოწერა" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="YouTube · Facebook · Instagram · TikTok · X და სხვა — ჩასვი ლინკი"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotYt" Width="8" Height="8" Fill="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtYtChip" Text="yt-dlp…" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── URL BAR ─────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="50" CornerRadius="13" Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtUrl" Background="Transparent" BorderThickness="0"
                                     Padding="0,0,8,0" FontSize="14" VerticalContentAlignment="Center"
                                     KeyDown="TxtUrl_KeyDown" TextChanged="TxtUrl_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="ჩასვი ვიდეოს ლინკი…" FontSize="14" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" x:Name="BtnClearUrl" Style="{StaticResource GhostButton}"
                                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="34" Height="34"
                                    Padding="0" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnClearUrl_Click"
                                    ToolTip="გასუფთავება"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" x:Name="BtnPaste" Style="{StaticResource SecondaryButton}" Height="50"
                            Padding="16,0" Click="BtnPaste_Click" ToolTip="ბუფერიდან ჩასმა და მოძებნა">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="ჩასმა" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" x:Name="BtnFetchInfo" Style="{StaticResource PrimaryButton}" Height="50"
                            Padding="22,0" Click="BtnFetchInfo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="მოძებნა" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ── CONTENT ─────────────────────────────────────── -->
                <Grid Grid.Row="2" Margin="0,18,0,0">

                    <!-- empty state -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="96" Height="96" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource AccentSoft}"/>
                            <Ellipse Stroke="{DynamicResource AccentBorder}" StrokeThickness="1" Margin="10"/>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="ჩასვი ვიდეოს ლინკი" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,22,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enter-ით მოიძებნება · ან დააჭირე „ჩასმა“ და ბუფერიდან ავტომატურად აიღებს"
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Border Style="{StaticResource TileCard}" Padding="13,7" Margin="4,0"><TextBlock Text="YouTube" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></Border>
                            <Border Style="{StaticResource TileCard}" Padding="13,7" Margin="4,0"><TextBlock Text="Facebook" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></Border>
                            <Border Style="{StaticResource TileCard}" Padding="13,7" Margin="4,0"><TextBlock Text="Instagram" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></Border>
                            <Border Style="{StaticResource TileCard}" Padding="13,7" Margin="4,0"><TextBlock Text="TikTok" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></Border>
                            <Border Style="{StaticResource TileCard}" Padding="13,7" Margin="4,0"><TextBlock Text="X / Twitter" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- error -->
                    <Border x:Name="ErrorCard" Visibility="Collapsed" VerticalAlignment="Top"
                            Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}"
                            BorderThickness="1" CornerRadius="14" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource Danger}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtErrorTitle" Text="ვერ მოიძებნა" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtError" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="150"/>
                        </StackPanel>
                    </Border>

                    <!-- preview -->
                    <ScrollViewer x:Name="PreviewCard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Border CornerRadius="16" Background="{DynamicResource VideoBg}" Height="300" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ImgThumb" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                            Background="#CC0B0D10" CornerRadius="8" Padding="9,4">
                                        <TextBlock x:Name="TxtDurBadge" Text="0:00" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#F2F4F7" FontFamily="Consolas"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtVideoTitle" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                       MaxHeight="58" TextTrimming="CharacterEllipsis" Margin="2,16,0,0"/>
                            <WrapPanel x:Name="MetaChips" Margin="0,10,0,0"/>

                            <Grid Margin="0,18,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="CmbQuality" Height="48" FontSize="13.5"
                                          VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" x:Name="BtnAddToQueue" Style="{StaticResource SecondaryButton}"
                                        Height="48" Padding="16,0" Click="BtnAddToQueue_Click"
                                        ToolTip="სიაში დამატება და მოგვიანებით ერთად გადმოწერა">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,9,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="სიაში" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" x:Name="BtnDownload" Style="{StaticResource GlowPrimaryButton}"
                                        Height="48" Padding="24,0" Click="BtnDownload_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="გადმოწერა" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="TxtOptionsSummary" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       Margin="2,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PROGRESS ────────────────────────────────────── -->
                <Border Grid.Row="3" x:Name="StatusBorder" Visibility="Collapsed" Margin="0,16,0,0"
                        Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="14" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtStatus" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" x:Name="TxtPercent" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}" Margin="12,0,0,0"/>
                            </Grid>
                            <ProgressBar x:Name="PbProgress" Height="6" Margin="0,9,0,0" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="TxtSpeed" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnCancel" Style="{StaticResource DangerButton}"
                                Content="გაუქმება" Padding="16,9" FontSize="12.5" Margin="16,0,0,0"
                                Visibility="Collapsed" Click="BtnCancel_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ RIGHT PANEL: options / queue / history ═══════════ -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20,20,14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,6,16" HorizontalAlignment="Stretch">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="RbTabOpts" GroupName="DlTab" IsChecked="True" Style="{StaticResource SpeedSegment}"
                                     Content="პარამეტრები" Padding="8,8" Margin="0" Click="RightTab_Changed"/>
                        <RadioButton x:Name="RbTabQueue" GroupName="DlTab" Style="{StaticResource SpeedSegment}"
                                     Content="სია" Padding="8,8" Margin="0" Click="RightTab_Changed"/>
                        <RadioButton x:Name="RbTabHistory" GroupName="DlTab" Style="{StaticResource SpeedSegment}"
                                     Content="ისტორია" Padding="8,8" Margin="0" Click="RightTab_Changed"/>
                    </UniformGrid>
                </Border>

                <!-- ═ OPTIONS ═ -->
                <ScrollViewer Grid.Row="1" x:Name="OptsPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="რა გადმოვწერო" Style="{StaticResource SectionLabel}"/>

                        <Border Style="{StaticResource TileCard}">
                            <CheckBox x:Name="ChkAudioOnly" Style="{StaticResource ToggleSwitch}" Click="Options_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="მხოლოდ ხმა" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="MP3, საუკეთესო ხარისხით" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource TileCard}">
                            <CheckBox x:Name="ChkTimestamp" Style="{StaticResource ToggleSwitch}" Click="Options_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="მონაკვეთი" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="არჩეული დროის ინტერვალი" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border x:Name="TimestampPanel" Style="{StaticResource TileCard}" Visibility="Collapsed"
                                Background="{DynamicResource BgInput}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="დასაწყისი" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                                    <TextBox x:Name="TxtStartTime" Text="00:00:00" FontFamily="Consolas" FontSize="14" Height="40"
                                             TextChanged="Options_Changed_Text"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="დასასრული" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                                    <TextBox x:Name="TxtEndTime" Text="00:00:30" FontFamily="Consolas" FontSize="14" Height="40"
                                             TextChanged="Options_Changed_Text"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TileCard}">
                            <CheckBox x:Name="ChkSubtitles" Style="{StaticResource ToggleSwitch}" Click="Options_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="სუბტიტრები" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="ქართული და ინგლისური" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Text="გადმოწერის მერე" Style="{StaticResource SectionLabel}" Margin="2,12,0,10"/>

                        <Border Style="{StaticResource TileCard}">
                            <CheckBox x:Name="ChkAutoVertical" Style="{StaticResource ToggleSwitch}" Click="Options_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                        <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ავტო-ვერტიკალი" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="გადავა ვერტიკალში" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource TileCard}">
                            <CheckBox x:Name="ChkThumbs" Style="{StaticResource ToggleSwitch}" Click="Options_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,13,0">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="კადრების ამოღება" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="5 სურათი ვიდეოდან" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Text="შენახვის ადგილი" Style="{StaticResource SectionLabel}" Margin="2,12,0,10"/>
                        <Border Style="{StaticResource TileCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtFolder" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="შეცვლა"
                                        Padding="12,7" FontSize="12" Margin="10,0,6,0" Click="BtnChooseFolder_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE838;"
                                        Width="34" Height="34" Click="BtnOpenDownloadsFolder_Click"
                                        ToolTip="საქაღალდის გახსნა"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="სწრაფი პრესეტები — გადმოწერა + ვერტიკალი" Style="{StaticResource SectionLabel}"
                                   Margin="2,12,0,10"/>
                        <UniformGrid Rows="1" Margin="0,0,0,16">
                            <Button Style="{StaticResource SecondaryButton}" Content="TikTok" Tag="tiktok" Margin="0,0,6,0"
                                    Padding="0,12" FontWeight="SemiBold" Click="BtnSocialPreset_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Reels" Tag="reels" Margin="3,0,3,0"
                                    Padding="0,12" FontWeight="SemiBold" Click="BtnSocialPreset_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Shorts" Tag="shorts" Margin="6,0,0,0"
                                    Padding="0,12" FontWeight="SemiBold" Click="BtnSocialPreset_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═ QUEUE ═ -->
                <Grid Grid.Row="1" x:Name="QueuePanelHost" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,6,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDownloadAll" Style="{StaticResource PrimaryButton}" Content="ყველას გადმოწერა"
                                Padding="14,10" Click="BtnDownloadAll_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource ToolButton}" Content="&#xE8E5;" Margin="8,0,0,0"
                                ToolTip="URL-ების იმპორტი ფაილიდან ან ბუფერიდან" Click="BtnImportUrls_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE74D;" Margin="6,0,0,0"
                                ToolTip="სიის გასუფთავება" Click="BtnClearQueue_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock x:Name="TxtNoQueue" Text="სია ცარიელია. მოძებნე ვიდეო და დააჭირე „სიაში“, ან გამოიყენე იმპორტი — რამდენიმე ლინკი ერთდროულად."
                                       FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                            <StackPanel x:Name="QueuePanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═ HISTORY ═ -->
                <ScrollViewer Grid.Row="1" x:Name="HistoryPanelHost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock x:Name="TxtNoHistory" Text="ჯერ არაფერი არ გადმოწერილა."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="2,10,0,0"/>
                        <StackPanel x:Name="HistoryPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
